<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پست‌های کاربران</title>
    <link rel="stylesheet" href="/fontawesome-free-6.6.0-web/css/all.min.css" />
    <style>
        body {
            font-family: "dana";
            background: #1F2131;
            display: flex;
            justify-content: center;
            direction: rtl;
        }
        .post-container {
            width: 79%;
            margin: 100px 0;
            background-color: #1c08086c;
            border-radius: 10px;
            padding: 5px;
            color: white;
        }
        .post {
            background: #1F2131;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
        }
        .post-header {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }
        .post-header img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            margin-left: 10px;
        }
        .post-header .user-info {
            display: flex;
            flex-direction: column;
        }
        .post-header .user-info strong {
            font-size: 16px;
        }
        .post-content img {
            width: 100%;
            border-radius: 8px;
            margin-top: 10px;
        }
        .post-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 10px;
        }
        .like-button {
            color: #0073b1;
            cursor: pointer;
            font-size: 16px;
            display: flex;
            align-items: center;
        }
        .like-button i {
            margin-left: 5px;
        }
        a {
            text-decoration: none;
            color: white;
        }
    </style>
</head>
<body>
    <div class="post-container">
        <% post.reverse().forEach(user => { %> 
            <% user.posts.forEach(post => { %>  
                <div class="post" id="post-<%= post._id %>">
                    <div class="post-header">
                        <% if(user.profPhoto){ %>
                            <img src="<%= user.profPhoto %>" alt="User Profile">
                        <% } else { %>
                            <img src="/Images/profile.png" alt="User Profile">
                        <% } %>
                        <div class="user-info">
                            <strong style="font-size: 25px;"><%= user.name %></strong>
                        </div>
                    </div>
                    <div class="post-content">
                        <p style="font-size: 20px;"><%= post.content %></p>
                        <% if (post.newImagePost) { %>
                            <img src="<%= post.newImagePost %>" alt="Post Image">
                        <% } %>
                    </div>
                    <div class="post-footer">
                        <p id="like-count-<%= post._id %>"><%= post.likes.length %> Likes</p>
                        <button class="like-button" onclick="likePost('<%= post._id %>')">
                            <i class="<%= post.likes.indexOf(user._id) === -1 ? 'fas fa-thumbs-up' : 'fas fa-thumbs-down' %>"></i>
                            <span><%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %></span>
                        </button>
                    </div>
                </div>
            <% }) %>
        <% }) %>
    </div>

    <script>
        async function likePost(postId) {
            const res = await fetch(`/like/${postId}`, {
                method: 'POST'
            });
            const data = await res.json();

            // به‌روزرسانی تعداد لایک‌ها و وضعیت دکمه لایک
            const likeCountElem = document.getElementById(`like-count-${postId}`);
            const likeButtonElem = document.querySelector(`#post-${postId} .like-button`);
            const iconElem = likeButtonElem.querySelector('i');
            const spanElem = likeButtonElem.querySelector('span');

            likeCountElem.textContent = `${data.likes.length} Likes`;

            if (data.isLiked) {
                iconElem.classList.remove('fa-thumbs-up');
                iconElem.classList.add('fa-thumbs-down');
                spanElem.textContent = "Unlike";
            } else {
                iconElem.classList.remove('fa-thumbs-down');
                iconElem.classList.add('fa-thumbs-up');
                spanElem.textContent = "Like";
            }
        }
    </script>
</body>
</html>
