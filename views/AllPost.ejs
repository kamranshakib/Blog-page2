<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/css/Style.css" />
    <!-- font Awesime -->
    <link rel="stylesheet" href="/fontawesome-free-6.6.0-web/css/all.min.css" />
  </head>
  <style>
    ::-webkit-scrollbar{
      width: 10px;
      border-radius: 10px;
    }
    ::-webkit-scrollbar-track{
      background-color: #1c1c1c;
    }
    ::-webkit-scrollbar-thumb{
      background-color: #cdcdcd;
    }
    #imgPost{
      width: 100%;
    }
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(33, 3, 30, 0.788);
      z-index: 5;
      border-radius: 20px;
    }
    .modal-content {
      background: white;
      /* padding: 20px; */
      width: 400px;
      height: auto;
      margin: 100px auto;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 20px;
      position: relative;
    }
    .close {
      cursor: pointer;
      float: right;
      position: absolute;
      right: 20px;
      top: 5px;
      font-size: 40px;
    }
    #newpostInput {
      width: 300px;
      max-width: 300px;
      padding: 10px;
      height: auto;
      text-align: right;
      border-radius: 0;
      overflow-x: hidden;
    }
    #submitPost {
      margin-top: 20px;
      margin-bottom: 20px;
      width: 100px;
      border-radius: 5px;
      text-align: center;
      padding: 0;
      height: 40px;
      background: linear-gradient(
        10deg,
        rgb(255, 18, 219),
        rgba(9, 53, 227, 0.377)
      );
      color: white;
      font-size: 16px;
    }
    #chooseImage {
      border: none;
      padding: 0;
      margin: 0;
      width: 200px;
      height: 50px;
      border-radius: 0;
      text-align: center;
    }
    .inputs {
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: left;
      align-items: end;
      gap: 10px;
    }

    a{
      text-decoration: none;
      color: white;
    }
  </style>

  <body >
    <div class="navabr">
      <div  class="homeIcon"><i style="font-size: 16px; margin-top: 5px;" class="fas fa-home"></i> <span ><a href="/AllPost">Home</a></span></div>
      <div class="myblogIcon" style="transform: translateX(-30px);">
        <i style="font-size: 16px; margin-top: 5px;"  class="fas fa-user"></i><span ><a  href="/profile">Profile</a></span>
      </div>
    </div>

    <div class="container">
      <div class="left">
        <div class="header_photo"></div>
        <div class="Bio_photo">
          <img src="<%= user.profPhoto %>" alt="" />
        </div>
        <div style="display: flex; justify-content: center ;align-items: center; margin-top: 10px;">
          <h2 style="color: rgba(255, 255, 255, 0.81);  "><%= user.name %></h2>
        </div>
      </div>

      <div class="center">
        <div class="serch">
          <input style="margin-right: 70px;" id="newPostBtn" type="text" placeholder="پست خودرا بنویسید " />
          <div id="modal" class="modal">
            <div class="modal-content">
              <span class="close">&times;</span>
              <form
                action="/create-post"
                method="post"
                enctype="multipart/form-data"
              >
                <h2
                  style="
                    text-align: center;
                    margin-bottom: 10px;
                    margin-top: 20px;
                  "
                >
                  پست جدید
                </h2>
               
                <div class="inputs">
                  <textarea
                    id="newpostInput"
                    type="text"
                    name="content"
                    placeholder="...متن خودرا بنوسید"
                  ></textarea>
                  <input
                    id="chooseImage"
                    name="newImagePost"
                    type="file"
                    accept="image/*"
                  />
                </div>
                <input id="submitPost" value="ثبت پست" type="submit" />
              </form>
            </div>
          </div>

          <div class="photo">
            <img src="<%= user.profPhoto %>" alt="aaa" />
          </div>
        </div>
        <div class="postMain">
          <% user.posts.reverse().forEach((element) => { %>
          <div class="FristPost">
            <div class="img">
              <img src="<%= user.profPhoto %>" alt="hello" />
            </div>
            <h3 style="color: white;"><%= user.name %></h3>
            <p style="color: white;"><%= element.content %></p>

            <% if (element.newImagePost) { %>
            <img id="imgPost" src="<%= element.newImagePost %>" alt="Post Image" />
            <% } %>
          </div>
          <hr />
          <% }); %>
        </div>
      </div>
      <div class="right"></div>
    </div>

    <script>
      const modal = document.getElementById("modal");
      const btn = document.getElementById("newPostBtn");
      const close = document.querySelector(".close");

      btn.onclick = function () {
        modal.style.display = "block";
      };
      close.onclick = function () {
        modal.style.display = "none";
      };
      window.onclick = function (event) {
        if (event.target === modal) {
          modal.style.display = "none";
        }
      };
    </script>
  </body>
</html>
