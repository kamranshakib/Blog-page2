<!DOCTYPE html>
<html lang="fa">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>فرم ثبت‌نام</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.0/css/all.min.css" />
    <!-- Font Vazirmatn -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn&display=swap" rel="stylesheet" />

    <style>
      body {
        margin: 0;
        font-family: 'Vazirmatn', sans-serif;
        background: linear-gradient(to right, #00c6ff, #0072ff);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        direction: rtl;
      }

      .card {
        backdrop-filter: blur(10px);
        background-color: rgba(255, 255, 255, 0.15);
        border-radius: 20px;
        padding: 30px;
        width: 100%;
        max-width: 400px;
        color: white;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
      }

      .form-group {
        position: relative;
        margin-bottom: 20px;
      }

      .form-group i {
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        color: #ffffffcc;
      }

      .form-control {
        padding-right: 40px;
        border-radius: 12px;
        border: none;
        height: 45px;
      }

      .form-control:focus {
        box-shadow: none;
        outline: none;
      }

      .profile-upload {
        text-align: center;
        margin-bottom: 25px;
        position: relative;
      }

      .profile-upload img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #fff;
      }

      .profile-upload label i {
        position: absolute;
        right: 45%;
        bottom: 0;
        font-size: 20px;
        background: white;
        color: #0072ff;
        border-radius: 50%;
        padding: 6px;
        cursor: pointer;
        border: 2px solid #0072ff;
      }

      .profile-upload input {
        display: none;
      }

      .btn-primary {
        background-color: #fff;
        color: #0072ff;
        font-weight: bold;
        border-radius: 12px;
        border: none;
      }

      .btn-primary:hover {
        background-color: #f0f0f0;
      }

      .login-link {
        text-align: center;
        margin-top: 15px;
        color: #fff;
        text-decoration: none;
      }

      .login-link:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <form action="/register" method="post" enctype="multipart/form-data">
        <div class="profile-upload">
          <label for="photo">
            <img id="preview" src="https://via.placeholder.com/120" alt="پروفایل" />
            <i class="fa fa-camera"></i>
          </label>
          <input type="file" id="photo" name="profPhoto" accept="image/*" />
        </div>

        <div class="form-group">
          <i class="fa fa-user"></i>
          <input type="text" name="name" class="form-control" placeholder="نام کامل" required />
        </div>

        <div class="form-group">
          <i class="fa fa-envelope"></i>
          <input type="email" name="email" class="form-control" placeholder="ایمیل" required />
        </div>

        <div class="form-group">
          <i class="fa fa-phone"></i>
          <input type="tel" name="phone" class="form-control" placeholder="شماره تماس" required />
        </div>

        <div class="form-group">
          <i class="fa fa-lock"></i>
          <input type="password" name="password" class="form-control" placeholder="رمز عبور" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">ثبت‌نام</button>

        <a href="/login" class="login-link">قبلاً ثبت‌نام کرده‌ام</a>
      </form>
    </div>

    <script>
      const photoInput = document.getElementById("photo");
      const previewImg = document.getElementById("preview");

      photoInput.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function (e) {
            previewImg.src = e.target.result;
          };
          reader.readAsDataURL(file);
        }
      });
    </script>
  </body>
</html>
